// GC stress: struct whose fields are heap-allocated (Buffer<Int>).
// Each call to makeNode allocates a struct + a buffer. Repeated
// reassignment verifies gc_inc/gc_dec keeps refcounts balanced with
// no leaks and no double-frees.

struct Node {
    [Int] data,
    Int  tag
}

func makeNode(Int tag, Int size) Node {
    let buf = @[#Int size]
    let i = 0
    while i < size {
        buf[i] = tag * 10 + i
        i = i + 1
    }
    @Node{ data = buf, tag = tag }
}

func sumNode(Node n) Int {
    let s = 0
    let i = 0
    while i < n.data._size {
        s = s + n.data[i]
        i = i + 1
    }
    s
}

func main() Int {
    // Create, use, then overwrite — old Node (and its buffer) must be freed.
    let n = makeNode(1, 3)
    println(sumNode(n))         // 10+11+12 = 33

    n = makeNode(2, 4)
    println(sumNode(n))         // 20+21+22+23 = 86

    n = makeNode(3, 2)
    println(sumNode(n))         // 30+31 = 61

    // Multiple live nodes simultaneously.
    let a = makeNode(4, 2)
    let b = makeNode(5, 2)
    println(sumNode(a) + sumNode(b))  // (40+41)+(50+51) = 182

    1
}
