func countTrue([Bool] flags) Int {
    let n = flags._size
    let count = 0
    let i = 0
    while i < n {
        if flags[i] {
            count = count + 1
        }
        i = i + 1
    }
    count
}

func main() Int {
    let flags = @[true, false, true, true, false]
    println(flags._size)
    println(countTrue(flags))

    flags[0] = false
    println(countTrue(flags))
    flags[2] = false
    println(countTrue(flags))

    let chars = @['h', 'e', 'l', 'l', 'o']
    println(chars._size)
    let i = 0
    while i < chars._size {
        print(chars[i])
        i = i + 1
    }
    println('')

    chars[0] = 'H'
    i = 0
    while i < chars._size {
        print(chars[i])
        i = i + 1
    }
    println('')

    let alloc = @[#Bool 4]
    alloc[0] = true
    alloc[1] = false
    alloc[2] = true
    alloc[3] = true
    println(countTrue(alloc))

    1
}
