import("bbc-lib/Buffer.bbc") as buffer
import("strings") as strings


func levenshtein(String a, String b) !Int {
    if min(a._size, b._size) == 0
        max(a._size, b._size)
    elif a[0] == b[0]
        levenshtein(strings.truncate(a, 1, a._size), strings.truncate(b, 1, b._size))
    else  {
        let l1 = levenshtein(strings.truncate(a, 1, a._size), b)
        let l2 = levenshtein(a, strings.truncate(b, 1, b._size))
        let l3 = levenshtein(strings.truncate(a, 1, a._size), strings.truncate(b, 1, b._size))
        1 + min(min(l1, l2), l3)
    }
}

func levenshtein_dp(String a, String b) !Int {
    let n = a._size
    let m = b._size

    // Allocate (n+1) rows; each row is an uninitialized [Int] slot
    let matrix = @[#[Int] (n + 1)]

    // Allocate each row with (m+1) columns
    let i = 0
    while i <= n {
        matrix[i] = @[#Int (m + 1)]
        i = i + 1
    }

    // Base case: cost of deleting i characters from a
    i = 0
    while i <= n {
        matrix[i][0] = i
        i = i + 1
    }

    // Base case: cost of inserting j characters from b
    let j = 0
    while j <= m {
        matrix[0][j] = j
        j = j + 1
    }

    // Fill the DP table
    i = 1
    while i <= n {
        j = 1
        while j <= m {
            if a[i - 1] == b[j - 1] 
                matrix[i][j] = matrix[i - 1][j - 1]
            else 
                matrix[i][j] = 1 + min(matrix[i - 1][j], matrix[i][j - 1], matrix[i - 1][j - 1])
            j = j + 1
        }
        i = i + 1
    }

    matrix[n][m]
}

func main() !Int {
    let a = "cazejfnzkefnert"
    let b = "cuzezfnkzenffnt"
    //println(levenshtein(a, b))
    println(levenshtein_dp(a, b))
    0
}
